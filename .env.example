# ============================================================
# COT Tracker — Payment System
# Environment Variables Template
#
# Copy to .env.local for development
# Set in Vercel → Settings → Environment Variables for production
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # NEVER expose to client

# Public (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── PayPal ────────────────────────────────────────────────────
# sandbox | production
PAYPAL_ENV=sandbox

# From developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=AX...
PAYPAL_CLIENT_SECRET=EL...

# From PayPal Developer → Webhooks → your webhook → Webhook ID
PAYPAL_WEBHOOK_ID=4WU...

# ── Resend (email) ────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=COT Tracker <noreply@marketmoneyfx.com>
RESEND_REPLY_EMAIL=support@marketmoneyfx.com

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cot-tracker.vercel.app


# ============================================================
# SANDBOX SETUP GUIDE
# ============================================================
#
# 1. CREATE SANDBOX ACCOUNTS
#    developer.paypal.com → Sandbox → Accounts → Create Account
#    - Business account: sb-XXXXXX@business.example.com
#    - Personal (buyer): sb-XXXXXX@personal.example.com (balance: $500)
#
# 2. CREATE SANDBOX APP
#    developer.paypal.com → My Apps & Credentials → Sandbox → Create App
#    → Copy Client ID + Secret → paste above
#
# 3. REGISTER WEBHOOK
#    App → Webhooks → Add Webhook
#    URL: https://YOUR_NGROK_OR_VERCEL_PREVIEW/api/webhooks/paypal
#    Events to subscribe:
#      ✓ PAYMENT.CAPTURE.COMPLETED
#      ✓ CHECKOUT.ORDER.APPROVED
#      ✓ PAYMENT.CAPTURE.DENIED
#      ✓ PAYMENT.CAPTURE.REFUNDED
#    → Copy Webhook ID → paste as PAYPAL_WEBHOOK_ID
#
# 4. LOCAL TESTING WITH NGROK
#    npx ngrok http 3000
#    → use the https URL as webhook endpoint
#
# 5. SIMULATE WEBHOOK (no real payment needed)
#    developer.paypal.com → Sandbox → Webhooks → Simulate
#    → Event type: PAYMENT.CAPTURE.COMPLETED
#    → Click "Send Test"
#    → Check your /api/webhooks/paypal logs
#
# 6. FULL SANDBOX TEST FLOW
#    a. Add buyer email to users_access in Supabase with status=trial
#    b. Go to pricing.html → click "Elegir Mensual" (uses SANDBOX link if PAYPAL_ENV=sandbox)
#    c. Log in with sandbox buyer account
#    d. Complete payment
#    e. Check Vercel logs for webhook
#    f. Check Supabase payments + fulfillment_logs tables
#    g. Check inbox for welcome email (real delivery via Resend in sandbox too)
#
# 7. SWITCH TO PRODUCTION
#    - Change PAYPAL_ENV=production
#    - Create Live app in PayPal Developer
#    - Update PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID
#    - Update webhook URL to production domain
