# ============================================================
# COT Tracker — Variables de Entorno
#
# Copiar a .env.local para desarrollo local
# Configurar en Vercel → Settings → Environment Variables para producción
#
# CRÍTICO: Todas las variables marcadas *** DEBEN estar en Vercel
# ============================================================

# ── Supabase (CLIENTE — prefijo VITE_ para Vite) ─────────────
# Obtener en: supabase.com → tu proyecto → Settings → API
# IMPORTANTE: VITE_SUPABASE_ANON_KEY debe ser el JWT (empieza con eyJ...)
# NO usar el formato sb_publishable_... — ése es un formato obsoleto/incorrecto

VITE_SUPABASE_URL=https://ijuysabdwobmhdmhxrnz.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # ← JWT real de tu proyecto

# ── Supabase (SERVIDOR — NUNCA exponer al cliente) ────────────
# Obtener en: supabase.com → tu proyecto → Settings → API → service_role
SUPABASE_URL=https://ijuysabdwobmhdmhxrnz.supabase.co            # ← MISMO proyecto que VITE_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────
# Obtener en: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...       # sk_test_... para sandbox
STRIPE_WEBHOOK_SECRET=whsec_...     # Webhook → Signing secret

# Stripe Price IDs (ya configurados — no cambiar salvo que cambien los precios)
# Mensual    24 EUR: price_1TQdW7B7QeisGCzWnuzk8SLI
# Trimestral 59 EUR: price_1TQdc6B7QeisGCzWYXRSJNGc
# Semestral  99 EUR: price_1TQdfUB7QeisGCzWkhQSRQAE
# Anual     169 EUR: price_1TQdhfB7QeisGCzWEoFsJFhm

# ── Resend (email) ────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=COT Tracker <noreply@marketmoneyfx.com>
RESEND_REPLY_EMAIL=support@marketmoneyfx.com

# ── App ───────────────────────────────────────────────────────
APP_URL=https://cot-tracker.vercel.app
FRONTEND_ORIGIN=https://cot-tracker.vercel.app

# ── Precios de mercado en tiempo real ─────────────────────────
# Usadas SOLO en api/price.js (servidor). NUNCA con prefijo VITE_.
# El frontend llama a /api/price — las keys jamás llegan al navegador.
#
# Finnhub: https://finnhub.io → Dashboard → API Key
# TwelveData: https://twelvedata.com → Dashboard → API Keys
FINNHUB_API_KEY=tu_clave_finnhub_aqui
TWELVEDATA_API_KEY=tu_clave_twelvedata_aqui

# ── Datos macro (yields de bonos vía FRED) ────────────────────
# Gratuita. Obtener en: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=tu_clave_fred_aqui

# ── Calendario económico (RapidAPI) ───────────────────────────
# Plan $12/mes · 25k req/mes — fuente principal de actuals
RAPIDAPI_KEY=tu_clave_rapidapi_aqui

# ── Debug endpoint (opcional) ─────────────────────────────────
# Sin esta variable, /api/debug devuelve 404.
# Generar con: openssl rand -hex 32
# DEBUG_TOKEN=token_secreto_largo_aqui

# ── Financial Datasets (datos institucionales) ───────────────
# Obtener en: https://financialdatasets.ai → Dashboard → API Keys
# Usada SOLO en api/fd.js (servidor). NUNCA con prefijo VITE_.
# Habilita: equity intelligence, earnings regime, balance sheet stress, crypto ETF data.
# Plan sugerido: Professional ($99/mes) para >50k llamadas/mes.
# Sin esta variable, /api/fd devuelve 503 (graceful degradation).
FINANCIAL_DATASETS_API_KEY=tu_clave_financialdatasets_aqui

# ── Variables ELIMINADAS (borrar de Vercel si existen) ────────
# SHEETS_SCRIPT_URL       → no se usa
# VITE_FINNHUB_API_KEY    → reemplazada por FINNHUB_API_KEY
# VITE_TWELVEDATA_API_KEY → reemplazada por TWELVEDATA_API_KEY
# ALPHAVANTAGE_KEY        → solo en debug (ahora protegido)
# FMP_KEY                 → solo en debug (ahora protegido)
